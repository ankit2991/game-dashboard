{
  "name": "game-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/patch14-ensure-netlify-redirects.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "preflight:netlify": "node tools/patch14-ensure-netlify-redirects.mjs && node tools/patch14-netlify-preflight.mjs",
    "netlify:fix": "node tools/patch14-ensure-netlify-redirects.mjs",
    "test:patch1": "node --experimental-strip-types --test tests/patch1-wallet-contract.test.mjs",
    "test:patch2": "node --experimental-strip-types --test tests/patch1-wallet-contract.test.mjs tests/patch2-launch-contract.test.mjs",
    "test:patch3": "node --experimental-strip-types --test tests/patch1-wallet-contract.test.mjs tests/patch2-launch-contract.test.mjs tests/patch2-3-header-binding.test.mjs",
    "test:patch5": "node --experimental-strip-types --test tests/patch5-ledger-loss-contract.test.mjs tests/patch6-wallet.test.mjs",
    "test:patch6": "node --experimental-strip-types --test tests/patch6-money-leaderboard.test.mjs",
    "test:patch7": "node --test tests/patch14-netlify.test.mjs tests/patch14-redirects-build.test.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
