{
  "name": "game-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/patch14-ensure-netlify-redirects.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:auth-client": "node tools/patch2-auth-client-smoke.cjs",
    "test:catalog": "node --experimental-strip-types --test tests/patch3-catalog.test.mjs",
    "test:launch": "node --experimental-strip-types --test tests/patch4-launch.test.mjs",
    "test:leaderboard": "node --experimental-strip-types --test tests/patch5-leaderboard.test.mjs",
    "test:wallet": "node --experimental-strip-types --test tests/patch6-wallet.test.mjs",
    "test:operator": "node --experimental-strip-types --test tests/patch7-operator.test.mjs",
    "test:operator-workspace": "node --experimental-strip-types --test tests/patch8-operator-workspace.test.mjs",
    "test:operator-operations": "node --experimental-strip-types --test tests/patch9-operator-operations.test.mjs",
    "test:admin": "node --test tests/patch10-admin.test.mjs",
    "test:release": "node --experimental-strip-types --test tests/patch12-release.test.mjs",
    "test:netlify": "node --test tests/patch14-netlify.test.mjs",
    "test:game-icons": "node --experimental-strip-types --test tests/patch15-game-icons.test.mjs",
    "preflight:netlify": "node tools/patch14-ensure-netlify-redirects.mjs && node tools/patch14-netlify-preflight.mjs",
    "netlify:fix": "node tools/patch14-ensure-netlify-redirects.mjs",
    "test:dev-api": "node --test tests/patch-live-dev-proxy.test.mjs",
    "diagnose:api": "node tools/patch-local-api-diagnose.mjs",
    "test:auth-patch15": "node --experimental-strip-types --test tests/patch15-auth-validation.test.mjs",
    "test:operator-dashboard": "node --experimental-strip-types --test tests/patch17-operator-dashboard.test.mjs",
    "test:admin-patch18": "node --test tests/patch18-admin-management.test.mjs",
    "test:launch-capabilities": "node --experimental-strip-types --test tests/patch19-launch-capabilities.test.mjs",
    "test:cleanup": "node --test tests/patch20-cleanup.test.mjs",
    "test:patch21": "node --test tests/patch21-release.test.mjs",
    "release:verify": "npm run build && npm run preflight:netlify && node tools/patch21-release-preflight.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
