# Copy to .env.local for local development (not committed).
# Development: leave VITE_API_BASE_URL empty to use Vite's /api proxy.
# Vite dev server: http://localhost:5175; Backend default http://127.0.0.1:3001
VITE_API_BASE_URL=
VITE_DEV_BACKEND_URL=http://127.0.0.1:3001

# Production on Vercel: set VITE_API_BASE_URL to deployed Render HTTPS origin,
# e.g. https://your-render-backend.onrender.com
# Do not include /api/v1 unless desired: both origin and origin/api/v1 work.
# NEVER put PARTNERS_JSON, B2B_ADMIN_API_KEY, GAME_*_ADAPTER_KEY,
# MONGODB_URI, or any other server-only secret in VITE_* variables.
